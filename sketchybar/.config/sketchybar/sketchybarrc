#!/bin/bash

# Omarchy-inspired bar, based on
# https://www.penkin.me/development/tools/productivity/configuration/2025/11/28/building-omarchy-inspired-setup-macos.html

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Osaka Jade with sharp corners
sketchybar --bar position=top \
                 margin=0 \
                 y_offset=0 \
                 corner_radius=0 \
                 height=38 \
                 color=$BAR

##### Defaults #####
# Theme text, brighter when highlighted
default=(
  padding_left=0
  padding_right=4
  icon.font="JetBrainsMono Nerd Font:Regular:14.0"
  label.font="JetBrainsMono Nerd Font:Regular:14.0"
  icon.color=$TEXT
  label.color=$TEXT
  icon.highlight_color=$ACTIVE
  label.highlight_color=$ACTIVE
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Workspaces #####
# AeroSpace workspaces, each drawn on the bar of the display it lives on.
# Like Omarchy, 1-5 are always shown and 6-9 only appear when they have
# windows, unless an external display is connected and 6-9 have the MacBook
# to themselves. Clicking one switches to it.
sketchybar --add event aerospace_workspace_change

for sid in {1..9}; do
  sketchybar --add item space.$sid left \
             --set space.$sid \
                   icon=$sid \
                   icon.color=$INACTIVE \
                   icon.padding_left=8 \
                   icon.padding_right=8 \
                   label.drawing=off \
                   click_script="aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh $sid" \
             --subscribe space.$sid aerospace_workspace_change front_app_switched display_change
done

##### Status Items #####
# Omarchy centres the clock, but on a notch MacBook the centre is hidden
# behind the notch, so it sits on the far right instead.
# Right items are laid out right to left. Clicking an item opens its settings,
# like Omarchy's bar.
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       icon.drawing=off \
                       padding_right=8 \
                       script="$PLUGIN_DIR/clock.sh" \
                       click_script="open -a Calendar" \
           \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
                        click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
           --subscribe volume volume_change \
           \
           --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGIN_DIR/battery.sh" \
                         click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
           --subscribe battery system_woke power_source_change \
           \
           --add item wifi right \
           --set wifi update_freq=30 \
                      script="$PLUGIN_DIR/wifi.sh" \
                      click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
           --subscribe wifi wifi_change system_woke \
           \
           --add item cpu right \
           --set cpu update_freq=5 \
                     icon=󰍛 \
                     script="$PLUGIN_DIR/cpu.sh" \
                     click_script="$HOME/.config/aerospace/app.sh com.apple.ActivityMonitor"

##### Force all scripts to run the first time #####
sketchybar --update
